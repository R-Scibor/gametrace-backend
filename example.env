# ─────────────────────────────────────────────────────────────────────────────
# GameTrace backend configuration. `cp example.env .env` and fill the REQUIRED
# blocks. OPTIONAL blocks can be left as-is; features with missing config return
# 503 (voice, link codes) or silently skip (FCM, Sentry). See README.md → Quick
# start for the guided walkthrough.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Datastores (REQUIRED) ───────────────────────────────────────────────────
POSTGRES_USER=gametrace_user
POSTGRES_PASSWORD=gametrace_pass
POSTGRES_DB=gametrace_db
DATABASE_URL=postgresql+asyncpg://gametrace_user:gametrace_pass@db:5432/gametrace_db
REDIS_URL=redis://redis:6379/0

# ─── Discord (REQUIRED) ───────────────────────────────────────────────────────
# The bot gateway token — Developer Portal → Bot → Token. Runs the presence bot
# and slash commands. This is NOT the OAuth2 client secret below.
DISCORD_BOT_TOKEN=your_discord_bot_token
#
# Discord OAuth2 ("Sign in with Discord" from the mobile app). Same application
# as the bot, but DIFFERENT credentials — Developer Portal → OAuth2.
#   ⚠ DISCORD_CLIENT_SECRET is the OAuth2 secret, NOT DISCORD_BOT_TOKEN.
#     If it is blank (or set to the bot token) POST /auth/discord fails with
#     Discord's `invalid_client` and mobile login never completes.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Comma-separated allowlist of redirect URIs the app may use. Must match the
# Developer Portal → OAuth2 → Redirects entries exactly, or login returns 400
# (`redirect_uri not allowed`). Custom URL schemes are fine.
DISCORD_OAUTH_REDIRECT_URIS=gametrace://oauth
# Comma-separated server (guild) ids the user must belong to for the bot to
# track their presence. Login still succeeds for non-members (needs_server_join=true).
DISCORD_GUILD_IDS=

# ─── Login link codes (REQUIRED for /login) ──────────────────────────────────
# HMAC key for the 6-digit /login codes; generate with `openssl rand -hex 32`.
# Leave blank to disable the link-code login path.
LINK_CODE_SECRET=
# Shared secret gating the name-only dev login (POST /auth/login). That path
# proves no identity, so it stays disabled (404) unless this is set; when set,
# callers must send the same value in the X-Dev-Login-Secret header. Leave blank
# in any exposed deployment — use /auth/link or /auth/discord there instead.
# generate with `openssl rand -hex 32`.
DEV_LOGIN_SECRET=
# Comma-separated IPs or CIDR blocks allowed to set X-Forwarded-For, e.g. the
# NPM host or the Docker bridge range (172.16.0.0/12) — container IPs are
# dynamic, so prefer a range over an exact address. Malformed entries fail at boot.
TRUSTED_PROXY_IPS=

# ─── Game enrichment (REQUIRED) ──────────────────────────────────────────────
# IGDB via Twitch OAuth — Client ID + Secret from the Twitch dev console.
IGDB_CLIENT_ID=your_twitch_client_id
IGDB_CLIENT_SECRET=your_twitch_client_secret

# ─── Voice pipeline (OPTIONAL) ───────────────────────────────────────────────
# OpenAI Whisper (STT) + Vertex AI Gemini Flash (text→JSON). Endpoints 503 if unset.
OPENAI_API_KEY=your_openai_api_key
GCP_PROJECT=your-gcp-project
GCP_LOCATION=us-central1
# Service-account JSON for Vertex AI ADC. Mount credentials/gcp-sa.json into the api
# container (see docker-compose.yml) and point ADC at the in-container path.
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp-sa.json
# Gemini model ID (Vertex). Default gemini-3-flash-preview.
# GEMINI_MODEL=gemini-3-flash-preview
# Fallback IANA tz for voice datetime anchor when users.timezone is UTC or invalid.
# DEFAULT_TIMEZONE=Europe/Warsaw

# ─── Push notifications (OPTIONAL) ───────────────────────────────────────────
# Firebase Cloud Messaging service-account JSON. Mounted into api/worker/beat at
# /app/credentials/firebase-cred.json. FCM silently skips if the file is absent.
FIREBASE_CREDENTIALS_PATH=/app/credentials/firebase-cred.json

# ─── API docs (OPTIONAL) ─────────────────────────────────────────────────────
# Swagger UI / ReDoc / openapi.json. The schema documents every route, so set
# false on internet-facing deployments. Default true.
# ENABLE_API_DOCS=true

# ─── Auth & session tuning (OPTIONAL) ────────────────────────────────────────
# Sliding-window session token lifetime (days). Default 30.
SESSION_TOKEN_EXPIRE_DAYS=30
# Days before soft-deleted sessions are permanently purged. Default 7.
# TRASH_RETENTION_DAYS=7

# ─── Session-flicker thresholds (OPTIONAL) ───────────────────────────────────
# Max presence-dropout gap (seconds) that still counts as continuous play. Default 180.
# SESSION_STITCH_WINDOW_SECONDS=180
# Sessions shorter than this (seconds) are treated as junk flickers. Default 180.
# SESSION_SHORT_FLICKER_SECONDS=180
# How long a flicker-flagged row survives (seconds) before the GC purges it. Default 86400.
# Must be strictly greater than SESSION_STITCH_WINDOW_SECONDS.
# SESSION_FLICKER_GC_MARGIN_SECONDS=86400

# ─── Observability (OPTIONAL) ────────────────────────────────────────────────
# Sentry — leave blank to disable (zero overhead).
SENTRY_DSN=
SENTRY_ENVIRONMENT=homelab

# ─── Logging (OPTIONAL) ──────────────────────────────────────────────────────
# Unified JSON logging level and per-service component label (api/bot/worker/beat).
# LOG_LEVEL=INFO
# LOG_COMPONENT=

# Flower (Celery monitor) — basic auth in user:pass form. Leave blank to disable auth.
# Flower has no read-only mode; never expose without auth on a public host.
FLOWER_BASIC_AUTH=

# ─── Backups (OPTIONAL — compose profile: backup) ────────────────────────────
# Local pg_dump + covers tar. Host path should live off the OS/docker disk,
# e.g. /data/gametrace-backups on sda1.
# BACKUP_DIR=/data/gametrace-backups
# BACKUP_RETENTION_DAYS=7
# Optional second copy on another disk, e.g. /data/bulk/gametrace-backups (mount as /mirror in compose)
# BACKUP_MIRROR_DIR=/mirror

# ─── Health / version metadata (OPTIONAL) ────────────────────────────────────
# Populate GET /api/v1/health version fields (defaults: dev / unknown).
# GIT_SHA=abc1234
# BUILD_TIME=2026-06-12T12:00:00Z
# APP_VERSION=v1.5.0
